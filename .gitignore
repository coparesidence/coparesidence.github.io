# Publica SÓ o app. Fica só na máquina: cad/ (DWG/CAD, 1,9 GB), backups,
# arquivos intermediários de dados/ e configurações locais.
/*
!/.gitignore
!/README.md
!/index.html
!/app.js
!/vendor/
!/manifest.webmanifest
!/sw.js
!/icons/
!/dados/
!/voz/

/dados/*
!/dados/ruas.geojson
!/dados/lotes.geojson
!/dados/portaria.geojson
!/dados/pois.geojson
!/dados/rotatorias.geojson
!/dados/nomes_ruas.json

.DS_Store
